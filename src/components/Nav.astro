---
import { ui, type Lang } from "../data/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const s = t.sections;
const otherHref = lang === "en" ? "/pt/" : "/";
const links = [
  [s.about, t.nav.about],
  [s.experience, t.nav.experience],
  [s.projects, t.nav.projects],
  [s.research, t.nav.research],
  [s.stack, t.nav.stack],
  [s.contact, t.nav.contact],
];
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-line/60 bg-bg/70 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#top" class="font-mono text-sm text-ink">
      <span class="text-accent">nathan</span><span class="text-dim">@</span>data<span class="text-dim">:~$</span>
    </a>
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map(([id, label]) => (
          <li>
            <a href={`#${id}`} class="rounded-md px-3 py-2 text-sm text-muted transition hover:text-ink">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={otherHref}
      hreflang={lang === "en" ? "pt-BR" : "en"}
      class="rounded-md border border-line px-3 py-1.5 font-mono text-xs text-muted transition hover:border-accent hover:text-accent"
    >
      {t.switchLang}
    </a>
  </nav>
</header>
